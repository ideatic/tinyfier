<?php

/**
 * Stub para PHPStan de la parte de leafo/lessphp 0.5 que usa Tinyfier_CSS_LESS.
 * Hace falta porque lessc.inc.php usa la sintaxis $str{0}, que PHP 8 no puede leer,
 * y PHPStan no encuentra la clase. Solo describe la API real; no se carga nunca.
 */
class lessc
{
    /**
     * @param string                 $name
     * @param callable(array<int, mixed>): mixed $func
     */
    public function registerFunction($name, $func): void {}

    /**
     * @param string $name
     */
    public function setFormatter($name): void {}

    /**
     * @param bool $preserve
     */
    public function setPreserveComments($preserve): void {}

    /**
     * @param array<string, mixed> $variables
     */
    public function setVariables($variables): void {}

    /**
     * @param string $dir
     */
    public function addImportDir($dir): void {}

    /**
     * Llama a las funciones registradas (lib_*), que cambian el estado del objeto
     *
     * @phpstan-impure
     *
     * @param string      $string
     * @param string|null $name
     */
    public function compile($string, $name = null): string {}

    /**
     * Sin el segundo argumento ($outFname) devuelve el CSS; Tinyfier nunca lo pasa
     *
     * @phpstan-impure
     *
     * @param string $fname
     */
    public function compileFile($fname): string {}

    /**
     * @param array<int, mixed> $value
     *
     * @return array<int, mixed>|null
     */
    protected function coerceColor($value): ?array {}
}
